# Copy this file to .env and replace placeholder values. Never commit .env.
APP_ENV=local
APP_BASE_URL=/unified_healthcare_platform/public
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=carebridge
DB_USER=root
DB_PASSWORD=
MAIL_FROM=your-verified-sender@gmail.com
MAIL_FROM_NAME=CareBridge
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_AUTH=true
SMTP_USERNAME=your-verified-sender@gmail.com
SMTP_PASSWORD=your-google-app-password
SMTP_ENCRYPTION=tls
# SMS (Twilio) is optional; use real credentials only
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
